packages: .

-- Argon parses Haskell via the standalone, compiler-version-independent
-- ghc-lib-parser. The version of ghc-lib-parser used by Argon must match that
-- used by hlint used as a style check of the Argon code.
constraints:
    ghc-lib-parser ==9.12.3.20251228
  , ghc-lib-parser-ex ==9.12.0.0
  , hlint ==3.10
  , cpphs ==1.20.10
